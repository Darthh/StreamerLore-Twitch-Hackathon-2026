# Copy this file to .env. Never commit the filled-in .env.
# Demo runs locally with fictional history and does not connect to Twitch.
STREAMLORE_MODE=demo
PORT=8787
HOST=127.0.0.1

# Development viewer URL; use http://localhost:8787 for npm run build + npm start.
# Set a public HTTPS URL before sharing links with viewers.
STREAMLORE_PUBLIC_URL=http://localhost:5173

# Required in live mode: at least 12 characters. Demo moderator access is local-only.
STREAMLORE_MOD_PASSWORD=

# Set all three and STREAMLORE_MODE=live to connect Twitch.
# Use a user access token for this client ID with user:read:chat + user:write:chat.
# The broadcaster's own account is the simplest choice; it sends bot replies too.
TWITCH_CLIENT_ID=
TWITCH_ACCESS_TOKEN=
TWITCH_CHANNEL=

# Optional AI: manual recaps and lore work without a key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Optional database override. Defaults to data/demo.sqlite or data/live.sqlite.
# STREAMLORE_DB_PATH=data/live.sqlite

# Native "Add to Twitch channel" Extension host.
# Set STREAMLORE_MODE=extension for a public deployment (never expose demo mode).
# Every channel gets its own empty database; Twitch JWTs determine channel access.
TWITCH_EXTENSION_CLIENT_ID=
# Copy the BASE64 shared secret from your Extension's developer console.
TWITCH_EXTENSION_SECRET=

# Separate confidential Twitch OAuth app for each broadcaster's chat authorization.
# TWITCH_CLIENT_ID above belongs to this OAuth application, not the Extension.
TWITCH_CLIENT_SECRET=
# Must exactly match the redirect URI registered on the OAuth application.
# TWITCH_OAUTH_REDIRECT_URI=https://YOUR-BACKEND/auth/twitch/callback
TWITCH_OAUTH_REDIRECT_URI=
# Generate once with: openssl rand -base64 32
# Keep this key with backups; it encrypts stored access and refresh tokens.
STREAMLORE_TOKEN_ENCRYPTION_KEY=

# Default data/extensions; mount persistent storage here in production.
STREAMLORE_EXTENSION_DATA_DIR=data/extensions
STREAMLORE_MAX_CHANNELS=100
# Explicit localhost development only; leave false for the public deployment.
STREAMLORE_EXTENSION_LOCAL_TEST=false
# Optional comma-separated exact HTTPS testing origins; no wildcards.
STREAMLORE_EXTENSION_ORIGINS=
# Public HTTPS backend origin for the upload builder.
STREAMLORE_EXTENSION_API_URL=
# Fill these only after Twitch approval AND release, using the actual listing URL.
TWITCH_EXTENSION_RELEASED=false
TWITCH_EXTENSION_INSTALL_URL=
