# Copy this file to .env. Never commit the filled-in .env.
# Demo runs locally with fictional history and does not connect to Twitch.
STREAMLORE_MODE=demo
PORT=8787
HOST=127.0.0.1

# Development viewer URL; use http://localhost:8787 for npm run build + npm start.
# Set a public HTTPS URL before sharing links with viewers.
STREAMLORE_PUBLIC_URL=http://localhost:5173

# Required in live mode: at least 12 characters. Demo moderator access is local-only.
STREAMLORE_MOD_PASSWORD=

# Set all three and STREAMLORE_MODE=live to connect Twitch.
# Use a user access token for this client ID with user:read:chat + user:write:chat.
# The broadcaster's own account is the simplest choice; it sends bot replies too.
TWITCH_CLIENT_ID=
TWITCH_ACCESS_TOKEN=
TWITCH_CHANNEL=

# Optional AI: manual recaps and lore work without a key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Optional database override. Defaults to data/demo.sqlite or data/live.sqlite.
# STREAMLORE_DB_PATH=data/live.sqlite
